GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ClickUp — fallback API key (used for Team reports + meeting docs)
# Per-person keys go in companies.json under each salesPerson
CLICKUP_API_KEY=pk_your_clickup_api_key

# ClickUp Docs — workspace ID and doc ID for weekly meeting notes
# Find workspace ID in your ClickUp URL: https://app.clickup.com/{WORKSPACE_ID}/...
# Doc ID will be looked up via API or found in doc URL
CLICKUP_WORKSPACE_ID=308435
CLICKUP_MEETING_DOC_ID=your_doc_id

# Webhook server
PORT=3000
WEBHOOK_SECRET=your_secret_here

# Dashboard (Vercel) → Railway handoff for Gmail OAuth + manual activity posts
# NODE_SERVICE_URL=https://your-railway-host.up.railway.app
# DASHBOARD_URL=https://eod-creator.vercel.app

# Native mailbox tracking (Option B) — primary Email Sent path.
# One OAuth connection per (exec × client). At /settings/email each exec
# picks the client, then Gmail or Outlook.
#
# Shared redirect for both providers:
#   https://<railway-host>/oauth/mailbox/callback
#
# Gmail — Google Cloud Console → OAuth 2.0 Web client, scope gmail.readonly
# Consent screen stays in Testing. Add each mailbox as a test user:
#   https://console.cloud.google.com/auth/audience
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://your-railway-host.up.railway.app/oauth/mailbox/callback
#
# Outlook — Azure App Registration → Web redirect URI, delegated:
#   offline_access, User.Read, Mail.Read
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=https://your-railway-host.up.railway.app/oauth/mailbox/callback
# MICROSOFT_OAUTH_TENANT=common
#
# Optional AES key (16+ chars) to encrypt refresh tokens at rest
# TOKEN_ENCRYPTION_KEY=
#
# Mailbox sync schedule (node-cron). Default every 3 minutes.
# MAILBOX_SYNC_CRON=*/1 * * * *   # every minute (testing)
# MAILBOX_SYNC_CRON=*/3 * * * *   # production default

# Sales Exec Invoicing — fired on Job Won (manual / eod-entry form)
# https://sales-exec-invoicing-production.up.railway.app/webhook/eod-job-won
COMMISSION_WEBHOOK_URL=

# Postgres / Supabase
# Use the Supabase "Connection pooler" (Transaction mode) connection string for the service.
# Service role bypasses RLS — keep this OUT of any client-shipped code.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
